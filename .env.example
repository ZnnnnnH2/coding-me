# Copy this file to .env and fill in the values you want to use locally.

CODEINGME_ENABLE_LLM=0
CODEINGME_LLM_API_KEY=replace-with-your-key
CODEINGME_LLM_BASE_URL=https://your-provider.example/v1
CODEINGME_LLM_MODEL=gpt-5.4
CODEINGME_LLM_REASONING_EFFORT=medium
CODEINGME_LLM_TEMPERATURE=0.2
CODEINGME_LLM_TIMEOUT=90
CODEINGME_LLM_TRUST_ENV=1
CODEINGME_LLM_CACHE_ENABLED=1
CODEINGME_LLM_CACHE_SIZE=256
CODEINGME_LLM_MAX_RETRIES=2
CODEINGME_RUN_TESTS_IN_DOCKER=0
